# ── Wallets ──────────────────────────────────────────────────────────────────
WALLET_PASSWORD=changeme

# Provider wallet (runs the agent server)
PROVIDER_PRIVATE_KEY=0x...

# Client wallet (the marketplace user hiring an agent)
CLIENT_PRIVATE_KEY=0x...

# ── Network ───────────────────────────────────────────────────────────────────
NETWORK=bsc-testnet
RPC_URL=https://bsc-testnet-rpc.publicnode.com

# ── Contracts (SDK defaults — only override if deploying your own) ─────────────
# AgenticCommerce 0xa206c0517b6371c6638cd9e4a42cc9f02a33b0de
# EvaluatorRouter 0xd7d36d66d2f1b608a0f943f722d27e3744f66f25
# OptimisticPolicy 0xd6a4217588f6b1f5657a92a3e94e6422ad771cea
# ERC-8004 Registry 0x8004A818BFB912233c491871b3d84c89A494BD9e

# $U token + faucet (BSC Testnet — from Altana docs)
U_TOKEN_ADDRESS=0xc70B8741B8B07A6d61E54fd4B20f22Fa648E5565
U_FAUCET_ADDRESS=0x86e9197CC0F76E4e4aaa7082180945196bBAb5D3

# ── Agent server ─────────────────────────────────────────────────────────────
AGENT_HOST=https://your-agent.example.com
AGENT_PORT=8010

# ── 8004scan API (free Pro tier for hackathon) ────────────────────────────────
SCAN_API_KEY=

# ── TermiX report output dir ──────────────────────────────────────────────────
REPORT_OUTPUT_DIR=./report/runs
